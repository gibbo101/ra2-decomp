+// FUNCTION: GAMEMD 0x0050AF10
+void HouseClass::Update_Present_Super_Weapons(void)
+{
+	if (GameActive) {
+		bool isplayer = (PlayerPtr == this);
+		for (int s = 0; s < SuperWeapon.Count(); s++) {
+			if (SuperWeapon[s]->Is_Present() && ((SuperWeapon[s]->NeedsBuilding && !SuperWeapon[s]->Is_One_Time()) || IsDefeated)) {
+				bool present = false;
+				bool enabled = false;
+				if (!IsDefeated) {
+					for (int j = 0; j < ::Buildings.Count(); j++) {
+						BuildingClass * b = ::Buildings[j];
+						if (!b->IsInLimbo && b->IsActive && b->House->Fetch_ID() == Fetch_ID()) {
+							for (int k = 0; k < 3; k++) {
+								BuildingTypeClass const * upgrade = b->Upgrades[k];
+								if (upgrade != NULL && (upgrade->SuperWeapon == s || upgrade->SuperWeapon2 == s)) {
+									present = true;
+									if (!enabled) enabled = b->IsOn;
+								}
+							}
+							if (b->FirstActiveSWIdx() == s || b->SecondActiveSWIdx() == s) {
+								present = true;
+								if (enabled) break;
+								enabled = b->IsOn;
+							}
+							if (enabled && present) break;
+						}
+					}
+				}
+
+				if (SuperWeapon[s]->Class->DisableableFromShell && !Unsorted::SWAllowed) {
+					present = false;
+				}
+
+				int power = Power;
+				int drain = Drain;
+				if (power < drain && drain != 0) {
+					if (power == 0 || (double)power / (double)drain < 1.0) {
+						enabled = false;
+					}
+				}
+
+				int id = SuperWeapon[s]->Class->Fetch_Heap_ID();
+				int tab = SidebarClass::GetObjectTabIdx(RTTI_SUPERWEAPON, id, false);
+				if (!present || IsDefeated) {
+					if (SuperWeapon[s]->Lose() && PlayerPtr != NULL) {
+						if (isplayer) {
+							if (CurrentSWType == s) {
+								CurrentSWType = -1;
+							}
+							Map.RepaintSidebar(tab);
+						}
+						IsRecalcNeeded = true;
+					}
+				} else if (present && !enabled && SuperWeapon[s]->Is_Powered() && SuperWeapon[s]->SetOnHold(true)) {
+					if (isplayer) {
+						if (CurrentSWType == s) {
+							CurrentSWType = -1;
+						}
+						Map.RepaintSidebar(tab);
+					}
+					IsRecalcNeeded = true;
+				} else if (present && enabled && SuperWeapon[s]->SetOnHold(false)) {
+					if (isplayer) {
+						if (CurrentSWType == s) {
+							CurrentSWType = -1;
+						}
+						Map.RepaintSidebar(tab);
+					}
+					IsRecalcNeeded = true;
+				}
+			}
+		}
+	}
+}
