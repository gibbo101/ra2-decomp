# Game binaries and the compiler are never committed: the player brings the game,
# a setup script fetches the toolchain.
orig/
toolchain/
build/
*.exe
*.dll
*.dbg
*.pdb
__pycache__/
.venv/

# Game assets and extracted game data: the player brings the game.
*.mix
*.shp
*.vxl
*.hva
*.pal
*.aud
*.wav
*.bik
*.vqa
*.csf
*.mpr
*.yrm
*.mmx
*.pcx
*.fnt

# Reverse-engineering databases embed the original exe.
*.gpr
*.rep/
*.idb
*.i64
/ghidra/

# Playtest copy of the game.
playtest/

# Secrets and local settings.
.env
.env.*
*.pem
*.key
.claude/settings.local.json

# Third-party reference clones.
reference/

# Built locally from YRpp by tools/setup_toolchain.sh; YRpp is a guide, not shipped.
data/symbols.csv
data/layouts.csv
